APP_NAME=CurePlus
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://cureplus.cygnatrix.com
APP_DOMAIN=cureplus.cygnatrix.com

APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Logs: daily files, kept 14 days, so they cannot eat into the inode limit.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

# Hostinger: the app connects to the local server. Do not use the srvNNNN.hstgr.io host.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# tracked-database is what makes "signed-in devices" and forced logout work.
SESSION_DRIVER=tracked-database
SESSION_LIFETIME=240
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Gmail SMTP: use an App Password (2-Step Verification must be on).
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# New registrations wait for a platform admin. Set false to activate at once.
ORG_REQUIRE_APPROVAL=true

AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
# Comma-separated proxy IPs, or * behind a CDN. Rate limits and audit IPs depend on this.
TRUSTED_PROXIES=

# SMS. "log" is development only and refuses to run in production.
SMS_DRIVER=http
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
SMS_SENDER_ID=
SMS_HTTP_TIMEOUT=5

# CAPTCHA on public forms: none | turnstile
CAPTCHA_DRIVER=none
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Custom domains (Phase 7)
CONNECT_HOST=connect.cureplus.cygnatrix.com
PLATFORM_IPV4=82.29.191.59
PLATFORM_IPV6=2a02:4780:a:2211:0:2396:1cf1:7

# Backups. BACKUP_KEY is optional; without it, backups are protected by APP_KEY.
BACKUP_DISK=local
BACKUP_OFFSITE_DISK=
BACKUP_RETENTION_DAYS=30
BACKUP_KEY=
DAILY_EMAIL_LIMIT=500

DEFAULT_PLAN=starter
SUBSCRIPTION_GRACE_DAYS=7
CONSENT_DAYS=30
DOCUMENT_LINK_HOURS=720

# Platform accounts. These can also be set in Super Admin, Integrations.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_LANGUAGE=en

# Off: no plan pages, limits, trial expiry or suspension. Charges are agreed with each practice directly.
SUBSCRIPTIONS_ENABLED=false

# Patients can only book a doctor whose registration has been checked.
DOCTOR_REQUIRE_APPROVAL=true

# Video calls. The default is Jitsi's free server. Doctors can save their own Google Meet link.
VIDEO_JITSI_URL=https://meet.jit.si
VIDEO_PAY_WITHIN_MINUTES=30
